rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only signed-in coaches/managers (accounts you create manually in the
    // Firebase console) can read or write contact records. There is no
    // public sign-up, so this keeps children's and parents' details private
    // to people you've explicitly given a login.
    match /contacts/{contactId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
