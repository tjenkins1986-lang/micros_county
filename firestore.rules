rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the club admin account below can read or write contact records.
    // Add more emails to the list as you bring on other coaches/managers.
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'thomas.jenkins1986@gmail.com',
          'scrfc-micros@outlook.com'
        ];
    }

    match /contacts/{contactId} {
      allow read, write: if isAllowedUser();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
